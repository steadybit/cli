# Adds a pty allocator to the shipped image so the prompts can be driven. Kept apart
# from Dockerfile so that nothing here reaches the image users install.
ARG IMAGE=steadybit/cli:latest
FROM ${IMAGE}

RUN apk add --no-cache expect

COPY e2e /e2e
ENTRYPOINT ["sh", "/e2e/run.sh"]
